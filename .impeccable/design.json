  "components": [
    {
      "name": "Masthead",
      "kind": "nav",
      "refersTo": "masthead",
      "description": "Header band: pine ground, Oswald wordmark, outlined buttons, triple-stripe rule beneath.",
      "html": "<div class=\"ds-mast\"><span class=\"ds-word\">amanvg</span><span class=\"ds-tools\"><button class=\"ds-icon\" aria-label=\"Switch to dark mode\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z\"/></svg></button><a class=\"ds-btn\" href=\"#\">Trust</a></span></div><div class=\"ds-stripes\"></div>",
      "css": ".ds-mast{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#24422e;border-bottom:3px solid #181c16} .ds-word{font-family:'Oswald','Arial Narrow',sans-serif;font-weight:700;font-size:28px;letter-spacing:.05em;text-transform:uppercase;color:#f6efe1} .ds-tools{display:flex;gap:12px} .ds-btn,.ds-icon{font-family:'Work Sans',system-ui,sans-serif;font-weight:700;font-size:14px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 22px;border:2px solid #f6efe1;color:#f6efe1;background:transparent;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s} .ds-icon{width:44px;padding:0} .ds-btn:hover,.ds-icon:hover{background:#ede3ce;color:#24422e;box-shadow:4px 4px 0 0 #181c16;transform:translate(-2px,-2px)} .ds-btn:active,.ds-icon:active{transform:translate(2px,2px);box-shadow:2px 2px 0 0 #181c16} .ds-btn:focus-visible,.ds-icon:focus-visible{outline:3px solid #f6efe1;outline-offset:3px} .ds-stripes{height:7px;background:linear-gradient(#24422e 0 3px,#d9822b 3px 5px,#a63a24 5px 7px)}"
    },
    {
      "name": "Header Button",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Outlined broadside button on the pine header; hover lifts on a hard strike shadow, press drops 2px.",
      "html": "<span style=\"display:inline-block;padding:16px;background:#24422e\"><a class=\"ds-btn\" href=\"#\">Trust</a></span>",
      "css": ".ds-btn,.ds-icon{font-family:'Work Sans',system-ui,sans-serif;font-weight:700;font-size:14px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 22px;border:2px solid #f6efe1;color:#f6efe1;background:transparent;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s} .ds-icon{width:44px;padding:0} .ds-btn:hover,.ds-icon:hover{background:#ede3ce;color:#24422e;box-shadow:4px 4px 0 0 #181c16;transform:translate(-2px,-2px)} .ds-btn:active,.ds-icon:active{transform:translate(2px,2px);box-shadow:2px 2px 0 0 #181c16} .ds-btn:focus-visible,.ds-icon:focus-visible{outline:3px solid #f6efe1;outline-offset:3px}"
    },
    {
      "name": "Theme Toggle",
      "kind": "button",
      "refersTo": "theme-toggle",
      "description": "Icon-only 44px square. Moon in light mode, sun in dark mode; aria-label names the mode it switches to.",
      "html": "<span style=\"display:inline-flex;padding:16px;background:#24422e\"><button class=\"ds-icon\" aria-label=\"Switch to dark mode\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z\"/></svg></button></span><span style=\"display:inline-flex;padding:16px;background:#141e17\"><button class=\"ds-icon ds-dark\" aria-label=\"Switch to light mode\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg></button></span>",
      "css": ".ds-btn,.ds-icon{font-family:'Work Sans',system-ui,sans-serif;font-weight:700;font-size:14px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 22px;border:2px solid #f6efe1;color:#f6efe1;background:transparent;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s} .ds-icon{width:44px;padding:0} .ds-btn:hover,.ds-icon:hover{background:#ede3ce;color:#24422e;box-shadow:4px 4px 0 0 #181c16;transform:translate(-2px,-2px)} .ds-btn:active,.ds-icon:active{transform:translate(2px,2px);box-shadow:2px 2px 0 0 #181c16} .ds-btn:focus-visible,.ds-icon:focus-visible{outline:3px solid #f6efe1;outline-offset:3px} .ds-icon.ds-dark{border-color:#35483b;color:#f4ede2} .ds-icon.ds-dark:hover{background:#1a271f;color:#f4ede2;border-color:#e5933a;box-shadow:4px 4px 0 0 #060a08}"
    },
    {
      "name": "Banner Plate",
      "kind": "card",
      "refersTo": "banner-plate",
      "description": "Framed poster crop: 3px double pine keyline (amber in dark) around the image with a 2px ink border.",
      "html": "<div class=\"ds-plate\"><div class=\"ds-img\"></div></div>",
      "css": ".ds-plate{border:3px double #24422e;padding:6px;background:#ede3ce} .ds-img{height:110px;border:2px solid #181c16;background:linear-gradient(90deg,#2c3f8f 0 38%,#2b2b2b 38% 88%,#9ccf5a 88%)}"
    },
    {
      "name": "Band Head",
      "kind": "custom",
      "refersTo": "band-head",
      "description": "Accordion header: flat band colour, Oswald caps title, chevron that rotates on open. Five bands step pine, mist, midnight, ochre, clay.",
      "html": "<div class=\"ds-list\"><button class=\"ds-head\" style=\"--c:#24422e;--fg:#f6efe1\"><span class=\"ds-title\">Sports</span><svg class=\"ds-chev\" viewBox=\"0 0 28 28\" width=\"22\" height=\"22\" aria-hidden=\"true\"><path d=\"M9 3l12 11-12 11-3-3 8-8-8-8z\" fill=\"currentColor\"/></svg></button><button class=\"ds-head\" style=\"--c:#60888f;--fg:#181c16\"><span class=\"ds-title\">Maps</span><svg class=\"ds-chev\" viewBox=\"0 0 28 28\" width=\"22\" height=\"22\" aria-hidden=\"true\"><path d=\"M9 3l12 11-12 11-3-3 8-8-8-8z\" fill=\"currentColor\"/></svg></button><button class=\"ds-head\" style=\"--c:#d9822b;--fg:#181c16\"><span class=\"ds-title\">Calculators</span><svg class=\"ds-chev\" viewBox=\"0 0 28 28\" width=\"22\" height=\"22\" aria-hidden=\"true\"><path d=\"M9 3l12 11-12 11-3-3 8-8-8-8z\" fill=\"currentColor\"/></svg></button></div>",
      "css": ".ds-list{border:3px solid #24422e;box-shadow:4px 4px 0 0 #181c16;background:#ede3ce} .ds-head{all:unset;box-sizing:border-box;cursor:pointer;display:grid;grid-template-columns:1fr 24px;align-items:center;column-gap:16px;width:100%;min-height:76px;padding:0 28px;background:var(--c);color:var(--fg)} .ds-head+.ds-head{border-top:2px solid #181c16} .ds-title{font-family:'Oswald','Arial Narrow',sans-serif;font-weight:700;font-size:40px;line-height:48px;letter-spacing:.04em;text-transform:uppercase} .ds-chev{transition:transform .4s cubic-bezier(.16,1,.3,1)} .ds-head:hover .ds-chev{translate:3px 0} .ds-head:focus-visible{outline:3px solid var(--fg);outline-offset:-8px}"
    },
    {
      "name": "Project Row",
      "kind": "custom",
      "refersTo": "project-row",
      "description": "Ledger row inside an open band: triangle marker, Oswald caps title, optional Vollkorn italic qualifier, arrow. Stripes alternate parchment and oatmeal; hover fills pine with a strike shadow.",
      "html": "<ul class=\"ds-rows\"><li><a class=\"ds-row\" href=\"#\"><span class=\"ds-pip\"><svg viewBox=\"0 0 14 14\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M7 0l7 14H0z\" fill=\"currentColor\"/></svg></span><h3>Seattle Sports</h3><svg viewBox=\"0 0 28 28\" width=\"20\" height=\"20\" aria-hidden=\"true\"><path d=\"M3 11h14l-5-6h5l8 9-8 9h-5l5-6H3z\" fill=\"currentColor\"/></svg></a></li><li><a class=\"ds-row ds-alt\" href=\"#\"><span class=\"ds-pip\"><svg viewBox=\"0 0 14 14\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M7 0l7 14H0z\" fill=\"currentColor\"/></svg></span><h3>MLB Stadiums <em>I have seen a game in</em></h3><svg viewBox=\"0 0 28 28\" width=\"20\" height=\"20\" aria-hidden=\"true\"><path d=\"M3 11h14l-5-6h5l8 9-8 9h-5l5-6H3z\" fill=\"currentColor\"/></svg></a></li></ul>",
      "css": ".ds-rows{list-style:none;border:2px solid #24422e} .ds-row{display:grid;grid-template-columns:18px 1fr 22px;align-items:center;column-gap:14px;min-height:60px;padding:0 28px;color:#181c16;text-decoration:none;background:#f6efe1;transition:transform .15s,box-shadow .15s,background .15s} .ds-alt{background:#ede3ce} .ds-pip{color:#24422e;display:flex} .ds-row h3{font-family:'Oswald','Arial Narrow',sans-serif;font-weight:600;font-size:22px;line-height:28px;letter-spacing:.02em;text-transform:uppercase;display:flex;align-items:baseline;gap:0 12px} .ds-row em{font-family:'Vollkorn',Georgia,serif;font-style:italic;font-weight:400;font-size:16px;letter-spacing:0;text-transform:none} .ds-row:hover{background:#24422e;color:#f6efe1;box-shadow:4px 4px 0 0 #181c16;transform:translate(-2px,-2px);position:relative} .ds-row:hover .ds-pip{color:#d9822b} .ds-row:active{transform:translate(2px,2px);box-shadow:2px 2px 0 0 #181c16} .ds-row:focus-visible{outline:3px solid #24422e;outline-offset:-6px}"
    },
    {
      "name": "Source Chip",
      "kind": "chip",
      "refersTo": "source-chip",
